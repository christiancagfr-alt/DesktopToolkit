# DesktopToolkit does not require a .env file for normal use.
# Prefer in-app preferences / OS user data for secrets.
# If you wire CI or local scripts, copy this file to `.env` (gitignored).

# Optional: OpenWeatherMap key (also configurable in 偏好设置)
# OWM_API_KEY=

# Optional: Cloudflare API token for Worker deploy scripts (never commit real values)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
